# Required: Linear webhook signing secret (from Linear Settings -> API -> Webhooks)
LINEAR_WEBHOOK_SECRET=replace-with-your-linear-webhook-secret

# Required when DRY_RUN=false: Linear Personal API Key (Settings -> API -> Personal API keys)
# Used ONLY to read ticket comments, post plan/debrief comments, and move tickets to In Review.
# Model execution uses your logged-in agy/claude/codex CLIs (no LLM API keys).
LINEAR_API_KEY=replace-with-your-linear-personal-api-key

# Required: Fixed absolute path to the default local git repository
REPO_PATH=/Users/willsaunders/webdev/screenwriter

# Default agent launcher when triggered: agy | claude | codex
# Can be overridden per issue using Linear labels: agent:agy, agent:claude, agent:codex
DEFAULT_AGENT=agy

# Only process issues that have this label (or an agent:<name> label).
# Set to empty string to accept every matching Issue event.
REQUIRED_LABEL=agent

# Optional label that triggers Phase 1 (Plan) before implementation.
# Tickets with `agent` but WITHOUT `plan` wait until moved to In Progress, then implement directly.
PLAN_LABEL=plan

# Optional label that authorizes the primary agent to act as orchestrator and
# delegate bounded subtasks to cheaper subagents, then review & verify their work.
DELEGATE_LABEL=delegate

# Workflow state names for Phase 2 trigger and completion
IN_PROGRESS_STATE_NAME=In Progress
IN_REVIEW_STATE_NAME=In Review
BLOCKED_STATE_NAME=Blocked

# Optional: custom @mention in the debrief comment (defaults to your Linear viewer displayName)
# REVIEW_MENTION=@will

# Concurrency & timeout
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_MS=1800000

# Server bind settings (localhost only; expose later via Tailscale Funnel)
HOST=127.0.0.1
PORT=8787

# Set to true to persist jobs and log commands without executing agents or calling Linear API
DRY_RUN=false
